generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  RISK_MANAGER
  ASSET_OWNER
  AUDITOR
  VIEWER

  @@map("role")
}

enum AssetCategory {
  HARDWARE
  SOFTWARE
  DATABASE
  NETWORK
  APPLICATION
  FACILITY
  OTHER

  @@map("asset_category")
}

/// Shared LOW/MEDIUM/HIGH/CRITICAL scale used for asset criticality and vulnerability severity.
enum Criticality {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("criticality")
}

enum ThreatCategory {
  MALICIOUS
  ACCIDENTAL
  ENVIRONMENTAL
  TECHNICAL_FAILURE
  THIRD_PARTY

  @@map("threat_category")
}

enum RiskCategory {
  CYBERSECURITY
  OPERATIONAL
  COMPLIANCE
  FINANCIAL
  STRATEGIC
  THIRD_PARTY

  @@map("risk_category")
}

enum RiskStatus {
  IDENTIFIED
  ASSESSED
  MITIGATING
  MONITORING
  CLOSED

  @@map("risk_status")
}

enum ControlType {
  PREVENTIVE
  DETECTIVE
  CORRECTIVE
  COMPENSATING

  @@map("control_type")
}

enum Effectiveness {
  LOW
  MEDIUM
  HIGH

  @@map("effectiveness")
}

enum TreatmentStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED

  @@map("treatment_status")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  firstName    String   @map("first_name")
  lastName     String   @map("last_name")
  role         Role
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  ownedAssets         Asset[]         @relation("AssetOwner")
  ownedRisks          Risk[]          @relation("RiskOwner")
  ownedTreatmentPlans TreatmentPlan[] @relation("TreatmentPlanOwner")
  auditLogs           AuditLog[]

  @@map("users")
}

model Asset {
  id          String        @id @default(uuid()) @db.Uuid
  name        String
  description String?
  category    AssetCategory
  criticality Criticality
  ownerId     String        @map("owner_id") @db.Uuid
  owner       User          @relation("AssetOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  vulnerabilities Vulnerability[]
  risks           Risk[]

  @@index([ownerId])
  @@map("assets")
}

model Threat {
  id          String         @id @default(uuid()) @db.Uuid
  name        String
  description String?
  category    ThreatCategory
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  risks Risk[]

  @@map("threats")
}

model Vulnerability {
  id          String      @id @default(uuid()) @db.Uuid
  name        String
  description String?
  severity    Criticality
  assetId     String      @map("asset_id") @db.Uuid
  asset       Asset       @relation(fields: [assetId], references: [id], onDelete: Restrict)
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  risks Risk[]

  @@index([assetId])
  @@map("vulnerabilities")
}

/// Likelihood and impact (1-5 each) are the only persisted risk-scoring inputs.
/// Risk score and risk level are derived at read time via packages/shared — never stored.
model Risk {
  id              String         @id @default(uuid()) @db.Uuid
  title           String
  description     String?
  category        RiskCategory
  status          RiskStatus     @default(IDENTIFIED)
  likelihood      Int
  impact          Int
  assetId         String         @map("asset_id") @db.Uuid
  asset           Asset          @relation(fields: [assetId], references: [id], onDelete: Restrict)
  threatId        String         @map("threat_id") @db.Uuid
  threat          Threat         @relation(fields: [threatId], references: [id], onDelete: Restrict)
  vulnerabilityId String?        @map("vulnerability_id") @db.Uuid
  vulnerability   Vulnerability? @relation(fields: [vulnerabilityId], references: [id], onDelete: SetNull)
  ownerId         String         @map("owner_id") @db.Uuid
  owner           User           @relation("RiskOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  riskControls   RiskControl[]
  treatmentPlans TreatmentPlan[]

  @@index([assetId])
  @@index([threatId])
  @@index([vulnerabilityId])
  @@index([ownerId])
  @@index([status])
  @@index([category])
  @@map("risks")
}

model Control {
  id            String        @id @default(uuid()) @db.Uuid
  name          String
  description   String?
  type          ControlType
  effectiveness Effectiveness
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")

  riskControls RiskControl[]

  @@map("controls")
}

model RiskControl {
  riskId    String   @map("risk_id") @db.Uuid
  risk      Risk     @relation(fields: [riskId], references: [id], onDelete: Cascade)
  controlId String   @map("control_id") @db.Uuid
  control   Control  @relation(fields: [controlId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now()) @map("created_at")

  @@id([riskId, controlId])
  @@index([controlId])
  @@map("risk_controls")
}

model TreatmentPlan {
  id        String          @id @default(uuid()) @db.Uuid
  riskId    String          @map("risk_id") @db.Uuid
  risk      Risk            @relation(fields: [riskId], references: [id], onDelete: Cascade)
  action    String
  ownerId   String          @map("owner_id") @db.Uuid
  owner     User            @relation("TreatmentPlanOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  dueDate   DateTime        @map("due_date")
  status    TreatmentStatus @default(OPEN)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@index([riskId])
  @@index([ownerId])
  @@index([status])
  @@map("treatment_plans")
}

/// Append-only. Rows are never updated or deleted by the application.
model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @map("user_id") @db.Uuid
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id") @db.Uuid
  oldValue   Json?    @map("old_value")
  newValue   Json?    @map("new_value")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([userId])
  @@map("audit_logs")
}
